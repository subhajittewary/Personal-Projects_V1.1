# Local development only. Never reuse these values in a shared or production environment.
COMPOSE_PROJECT_NAME=second-brain

APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
APP_SECRET_KEY=replace-with-a-local-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173

POSTGRES_HOST=postgres
POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=second_brain_dev_only
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH=neo4j/second_brain_dev_only

API_PORT=8000
WORKER_HEALTH_PORT=8080
MCP_PORT=8090
WEB_PORT=5173
