# Application
APP_NAME=AI Chat API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins. Use explicit domains in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set this when connecting a real AI provider. Never commit .env.
AI_API_KEY=
AI_MODEL=example-chat-model

